        <!-- Update Tickets card title on home page -->
        <template id="portal_tickets_home_title" inherit_id="helpdesk.portal_my_home_helpdesk_ticket" priority="60">
            <xpath expr="//div[@id='portal_service_category']//t[@t-call='portal.portal_docs_entry'][.//t[@t-set='url'][@t-value=&quot;'/my/tickets'&quot;]]" position="replace">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/helpdesk/static/src/img/tickets.svg'"/>
                    <t t-set="title">Trace/Submit Ticket</t>
                    <t t-set="text">Follow all your helpdesk tickets</t>
                    <t t-set="url" t-value="'/my/tickets'"/>
                    <t t-set="placeholder_count" t-value="'ticket_count'"/>
                </t>
            </xpath>
        </template>

        <!-- Add Submit Ticket button to tickets list page -->
        <template id="portal_tickets_list_submit_button" inherit_id="helpdesk.portal_helpdesk_ticket" priority="52">
            <xpath expr="//t[@t-call='portal.portal_searchbar']" position="after">
                <div class="mb-3">
                    <a href="/helpdesk" class="btn btn-primary">
                        <i class="fa fa-plus"></i> Submit New Ticket
                    </a>
                </div>
            </xpath>
        </template>
    </data>
    
